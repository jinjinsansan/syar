{
  "name": "star",
  "private": true,
  "version": "0.0.0",
  "description": "STAR - P0: genetics engine + 100-generation simulator",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "simulate": "tsx apps/cli/simulate.ts",
    "verify": "tsx apps/cli/src/verify.ts",
    "verify:distance": "tsx apps/cli/src/sweep-distance.ts",
    "verify:race": "tsx apps/cli/src/verify-race.ts",
    "preseed": "tsx apps/cli/src/preseed-run.ts",
    "preseed:verify": "tsx apps/cli/src/preseed-verify.ts",
    "worker": "tsx --env-file=secrets.local.env apps/worker/src/main.ts",
    "build:web": "npm -w @star/web exec next build",
    "verify:payout": "tsx apps/cli/src/verify-payout.ts",
    "blocklist:build": "tsx apps/cli/src/blocklist-build.ts",
    "test": "vitest run",
    "inventory": "node tools/inventory/measure.mjs",
    "mutation": "node tools/mutation/run.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.21.0",
    "pg": "^8.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
