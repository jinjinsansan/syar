# STAR — 環境変数の雛形（正典 §14）
#
# ⚠️ このファイルは**雛形**です。実値は書かないでください（コミットされます）。
#    実値は .env に入れてください。.env は .gitignore で除外されています。
#
# 使い方:
#   cp .env.example .env    # そのうえで .env に実値を入れる
#
# ★service_role キーはワーカー（サーバー側）だけが持ちます。
#   フロント（Vercel）には絶対に置かないでください。RLS を素通りする鍵です。

# ---- 環境の宣言（A-7: staging ワーカーが production DB に繋がると起動失敗する）----
# production | staging | development
# ★DB 側の app_environment テーブルと照合し、不一致なら起動を失敗させます。
#   接続文字列の取り違えは必ず起きる前提で、DB 側に真実を置きます（§14.6）。
STAR_ENV=development

# ---- Supabase ----
# ★フロント（Next.js）が読む名前。★`NEXT_PUBLIC_` が付いていないと**ブラウザから読めません**。
#   （★2026-09-19・AUDIT-ENV-ANON: ★ここが `SUPABASE_URL` / `SUPABASE_ANON_KEY` のままで、
#     ★`apps/web/src/lib/supabase.ts:10-11` が読む名前と食い違っていました。
#     ★雛形どおりに `.env` を作ると **Web が「未設定です」で落ちます**）
NEXT_PUBLIC_SUPABASE_URL=
# ★フロント用（公開されてよい）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ★ワーカー専用。RLS を素通りするので**サーバー側のみ**
#   ⚠️ ★**2026-09-19 から、ワーカーは要求しません**（★AU-1 で読み手 0 を確認・`apps/worker/src/env.ts`）。
#      ★ワーカーは `DATABASE_URL` で Postgres に直接つなぎます。★PostgREST を使う便が来たら、
#      ★**そのとき必要な場所で読むこと**。★置いてあっても害はありません。
SUPABASE_SERVICE_ROLE_KEY=
# Supabase CLI 用のアクセストークン（マイグレーション適用・型生成に使う）
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# プロジェクト参照ID（ダッシュボードURL の /project/<ここ>）
SUPABASE_PROJECT_REF=
# マイグレーション適用用の Postgres 接続文字列
DATABASE_URL=

# ---- ゲームループ（§10.2）----
# ★§8.6 の commit/reveal に使う秘密（★無くても起動します — ★起動ごとに作り直します）。
#   ⚠️ ★**公正性の検証は壊れません**（★`seed_commit` と `server_seed` は同じ 1 本の insert で行に入り、
#      ★検証は両方とも行から読みます・`fairness.ts`）。★固定すれば、起動をまたいで同じ列が出ます。
STAR_SEED_SECRET=
# 開催の起点（ISO8601・UTC）。★運用中に動かさないこと。
#   サイクル番号がここから決まるので、動かすと番号が付け替わり
#   「同じレースを二重に作らない」保証（A-2）が壊れます。
STAR_EPOCH_ISO=

# ---- 実在競走馬名 NG リスト（憲法 §0.1）----
# 平文は data/ng-names.txt（未コミット）に置き、npm run blocklist:build でハッシュ化。
# ハッシュ（data/ng-names.hash）だけがコミットされます。
