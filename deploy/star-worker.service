# STAR ゲームループワーカー（正典 §14）
#
# 配置: /etc/systemd/system/star-worker.service
# 有効化: sudo systemctl daemon-reload && sudo systemctl enable --now star-worker
#
# ★Render Background Worker の代わりに VPS を使う場合、Render が代行していた
#   「プロセスの自動再起動」を systemd が担います。正典 §14.2 は
#   「常時稼働ワーカー（Render Background Worker 等）」で実装先を固定していません。

[Unit]
Description=STAR game loop worker
After=network-online.target
Wants=network-online.target
# ★StartLimit* は [Unit] に置く。[Service] に書くと systemd に無視され、
#   「短時間に落ち続けたら止める」が効かない（VPS で実際に警告が出た）
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=star
WorkingDirectory=/opt/star
# ★秘密は systemd の EnvironmentFile で渡す。リポジトリにも履歴にも残さない
#   権限は 600 / 所有者 star にすること
EnvironmentFile=/etc/star/worker.env
# ★node --experimental-strip-types は一部の TS 構文を扱えず ERR_NO_TYPESCRIPT で落ちる。
#   リポジトリで既に使っている tsx を使う（npm ci で入る）。
ExecStart=/opt/star/node_modules/.bin/tsx apps/worker/src/main.ts

# ★A-1「24時間止まらない」の担保。落ちても必ず戻す
Restart=always
RestartSec=10
# ★短時間に落ち続けるなら止める設定は [Unit] にある（上を参照）

# ★SIGTERM で周の切れ目まで待つ。A-2 があるので途中で殺されても壊れないが、
#   無駄な再計算を避ける
KillSignal=SIGTERM
TimeoutStopSec=90

# 最低限の隔離
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/star

StandardOutput=journal
StandardError=journal
SyslogIdentifier=star-worker

[Install]
WantedBy=multi-user.target
